@filegroup
@glob **/*.md
@glob **/*.ts
@glob **/*.sdd
@glob **/*.py
@glob **/*.json
@glob **/*.yml
@glob **/*.sh
@glob **/*.ps1

@globexclude node_modules/**
@globexclude pnpm-lock.yaml
@globexclude dist/**

@# Excluding, because it's very large, comment this out when needed, and reexclude when possible.
@globexclude .specdd/bootstrap.md

@# Root provider override content is not useful for the current bridge/test migration.
@globexclude .specdd/bootstrap.project.md

@# Agent entrypoint files only redirect to the included SpecDD bootstrap.
@globexclude AGENTS.md
@globexclude CLAUDE.md

@# Local/generated SpecDD state
@globexclude .specdd/bootstrap.local.md

@# Installed/cached extension state; canonical source is integration/specdd/**
@globexclude .specify/extensions.yml
@globexclude .specify/extensions/specdd/**
@globexclude .specify/extensions/.cache/**

@# Installed/cached preset state; canonical source is integration/specdd-preset/**
@globexclude .specify/presets/specdd-bridge/**
@globexclude .specify/presets/.cache/**

@# Generated Spec Kit agent command registrations
@globexclude .specify-agent/commands/**
@globexclude .agents/skills/speckit-*/**

@# Generated upstream Spec Kit helper scripts
@globexclude .specify/scripts/**

@# Generated Spec Kit workflow state; canonical overlay source is integration/specdd/workflow-overlay.yml
@globexclude .specify/workflows/speckit/**
@globexclude .specify/workflows/overlays/**
@globexclude .specify/workflows/runs/**

@# Generated Spec Kit templates, placeholder governance state, and initialization bookkeeping
@globexclude .specify/templates/**
@globexclude .specify/memory/constitution.md
@globexclude .specify/init-options.json
@globexclude .specify/integration.json

@# Generated Spec Kit installation/bookkeeping metadata
@globexclude .specify/integrations/*.manifest.json
@globexclude .specify/memory/.constitution-template.json
@globexclude .specify/workflows/workflow-registry.json

@# Historical/exploratory design material has been superseded by the focused
@# Boundary target specifications and is not needed in normal implementation context.
@globexclude docs/spec-v0.1.md
@globexclude docs/architecture-exploration-guidance.md

@# P5 native-contract work now focuses on the provider-neutral core, contract
@# specification, architecture, TODO, and focused native tests.
@globexclude README.md
@globexclude README.sdd
@globexclude docs/TECH-DEBT.md
@globexclude docs/TECH-DEBT.sdd
@globexclude docs/spec-agent-instructions.md
@globexclude docs/spec-authorization.md
@globexclude docs/spec-lifecycle.md
@globexclude docs/change-boundary.sdd
@globexclude docs/development.sdd
@globexclude files.sdd

@# P5 is provider-neutral native contract work. Legacy bridge runtime,
@# packaging, and operational guides remain baseline code rather than design inputs.
@globexclude integration/specdd/**
@globexclude integration/specdd-preset/**
@globexclude scripts/**
@globexclude docs/change-boundary.md
@globexclude docs/development.md

@# Provider-upstream request history is not useful for the native Boundary migration.
@globexclude HUMAN-REQUEST-UPSTREAM-SPECDD-CLI.md

@# Provider-specific authority fixture data remains omitted until a migration
@# task explicitly converts or compares those contracts.
@globexclude tests/fixtures/specdd-two-domain/**

@# Existing bridge tests are baseline coverage rather than P5 design inputs.
@# Reinclude a focused legacy test only when a native parity or migration task needs it.
@globexclude tests/boundary_test_fixture.py
@globexclude tests/boundary_test_output.py
@globexclude tests/boundary_test_ownership.py
@globexclude tests/boundary_test_paths.py
@globexclude tests/boundary_test_resolver.py
@globexclude tests/boundary_test_support.py
@globexclude tests/preset_test_distribution.py
@globexclude tests/preset_test_install.py
@globexclude tests/preset_test_install_support.py
@globexclude tests/preset_test_source.py
@globexclude tests/preset_test_support.py
@globexclude tests/test_boundary.py
@globexclude tests/test_change_boundary_schema.py
@globexclude tests/test_preset.py
@globexclude tests/test_validation.py
@globexclude tests/test_verification.py
@globexclude tests/test_workflow.py
@globexclude tests/test_workflow_permissions.py
@globexclude tests/validation_test_engine.py
@globexclude tests/validation_test_fixture.py
@globexclude tests/validation_test_support.py
@globexclude tests/validation_test_tasks.py
@globexclude tests/verification_test_engine.py
@globexclude tests/verification_test_fixture.py
@globexclude tests/verification_test_git.py
@globexclude tests/workflow_test_gate.py
@globexclude tests/workflow_test_source.py
@endfilegroup
