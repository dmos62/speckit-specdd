@filegroup
@glob **/*.md
@glob **/*.ts
@glob **/*.sdd
@glob **/*.py
@glob **/*.json
@glob **/*.yml
@glob **/*.sh
@glob **/*.ps1

@globexclude node_modules/**
@globexclude pnpm-lock.yaml
@globexclude dist/**

@# Agent entrypoint files only redirect to the included SpecDD bootstrap.
@globexclude AGENTS.md
@globexclude CLAUDE.md

@# Local/generated SpecDD state
@globexclude .specdd/bootstrap.local.md

@# Installed/cached extension state; canonical source is integration/specdd/**
@globexclude .specify/extensions.yml
@globexclude .specify/extensions/specdd/**
@globexclude .specify/extensions/.cache/**

@# Installed/cached preset state; canonical source is integration/specdd-preset/**
@globexclude .specify/presets/specdd-bridge/**
@globexclude .specify/presets/.cache/**

@# Generated Spec Kit agent command registrations
@globexclude .specify-agent/commands/**
@globexclude .agents/skills/speckit-*/**

@# Generated upstream Spec Kit helper scripts
@globexclude .specify/scripts/**

@# Generated Spec Kit workflow state; canonical overlay source is integration/specdd/workflow-overlay.yml
@globexclude .specify/workflows/speckit/**
@globexclude .specify/workflows/overlays/**
@globexclude .specify/workflows/runs/**

@# Generated Spec Kit templates, placeholder governance state, and initialization bookkeeping
@globexclude .specify/templates/**
@globexclude .specify/memory/constitution.md
@globexclude .specify/init-options.json
@globexclude .specify/integration.json

@# Generated Spec Kit installation/bookkeeping metadata
@globexclude .specify/integrations/*.manifest.json
@globexclude .specify/memory/.constitution-template.json
@globexclude .specify/workflows/workflow-registry.json

@# P4 public identity and provider-isolation work is next.
@# Keep manifests, runtime source, installer/bootstrap source, commands, tests,
@# architecture docs, and user/developer docs available for the rename.

@globexclude HUMAN-REQUEST-UPSTREAM-SPECDD-CLI.md

@# Provider-specific authority fixture data remains omitted until a P4 change
@# requires modifying its contracts or expected resolver output.
@globexclude tests/fixtures/specdd-two-domain/**
@endfilegroup
