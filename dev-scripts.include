@# Surface bootstrap health, extension manifest/install discovery, the Change Boundary and validation suites, fixture lint, patch integrity, and worktree state to the next iteration.
@cli! bash -c "bash scripts/bootstrap.sh --check"
@cli! bash -c "cat integration/specdd/extension.sdd && printf '\n--- extension.yml ---\n' && cat integration/specdd/extension.yml"
@cli! bash -c "set -euo pipefail; if ! git diff --quiet -- .specify/extensions/.registry; then if git diff -w --quiet -- .specify/extensions/.registry; then git restore -- .specify/extensions/.registry; else printf 'extension smoke: pre-existing semantic registry change\n' >&2; git diff -- .specify/extensions/.registry; exit 1; fi; fi; test ! -e .specify/extensions/specdd; test ! -e .specify-agent/commands/speckit.specdd.context.md; test ! -e .specify-agent/commands/speckit.specdd.validate.md; trap 'specify extension remove specdd --force >/dev/null 2>&1 || true; git restore -- .specify/extensions/.registry >/dev/null 2>&1 || true' EXIT; specify extension add integration/specdd --dev --force; specify extension info specdd; test -f .specify-agent/commands/speckit.specdd.context.md; test -f .specify-agent/commands/speckit.specdd.validate.md; grep -F 'Build or refresh the active feature' .specify-agent/commands/speckit.specdd.context.md; grep -F 'Validate the active feature' .specify-agent/commands/speckit.specdd.validate.md; specify extension remove specdd --force; test ! -e .specify/extensions/specdd; test ! -e .specify-agent/commands/speckit.specdd.context.md; test ! -e .specify-agent/commands/speckit.specdd.validate.md; if ! git diff -w --quiet -- .specify/extensions/.registry; then printf 'extension smoke: uninstall changed registry semantics\n' >&2; git diff -- .specify/extensions/.registry; exit 1; fi; git restore -- .specify/extensions/.registry; trap - EXIT"
@cli! bash -c "uv run --no-project python -m unittest discover -s tests -p 'test_*.py'"
@cli! bash -c "specdd lint tests/fixtures/specdd-two-domain"
@cli! bash -c "git diff --check"
@cli! bash -c "git status --short"
