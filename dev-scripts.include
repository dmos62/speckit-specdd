@# Surface bootstrap health, extension manifest/install discovery, the Change Boundary suite, fixture lint, patch integrity, and worktree state to the next iteration.
@cli! bash -c "bash scripts/bootstrap.sh --check"
@cli! bash -c "cat integration/specdd/extension.sdd && printf '\n--- extension.yml ---\n' && cat integration/specdd/extension.yml"
@cli! bash -c "set -euo pipefail; registry=.specify/extensions/.registry; if ! git diff --quiet -- \"$registry\"; then if git diff -w --quiet -- \"$registry\"; then git restore -- \"$registry\"; else printf 'extension smoke: pre-existing semantic registry change\n' >&2; git diff -- \"$registry\"; exit 1; fi; fi; test ! -e .specify/extensions/specdd; test ! -e .specify-agent/commands/speckit.specdd.context.md; before=\"$(git status --porcelain --untracked-files=all -- .specify .specify-agent)\"; cleanup() { specify extension remove specdd --force >/dev/null 2>&1 || true; git restore -- \"$registry\" >/dev/null 2>&1 || true; }; trap cleanup EXIT; specify extension add integration/specdd --dev --force; specify extension info specdd; test -f .specify-agent/commands/speckit.specdd.context.md; grep -F 'Build or refresh the active feature' .specify-agent/commands/speckit.specdd.context.md; specify extension remove specdd --force; test ! -e .specify/extensions/specdd; test ! -e .specify-agent/commands/speckit.specdd.context.md; if ! git diff -w --quiet -- \"$registry\"; then printf 'extension smoke: uninstall changed registry semantics\n' >&2; git diff -- \"$registry\"; exit 1; fi; git restore -- \"$registry\"; after=\"$(git status --porcelain --untracked-files=all -- .specify .specify-agent)\"; if [[ \"$after\" != \"$before\" ]]; then printf 'extension smoke: generated Spec Kit state was not restored\nbefore:\n%s\nafter:\n%s\n' \"$before\" \"$after\" >&2; exit 1; fi; trap - EXIT"
@cli! bash -c "uv run --no-project python -m unittest discover -s tests -p 'test_*.py'"
@cli! bash -c "specdd lint tests/fixtures/specdd-two-domain"
@cli! bash -c "git diff --check"
@cli! bash -c "git status --short"
