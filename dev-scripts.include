@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "printf '%s\n' '--- P11 obsolete documentation terminology ---'; git grep -n -E 'SpecDD|Spec Kit.?×.?SpecDD|change-boundary' -- '*.md' ':!docs/spec-v0.1.md' ':!docs/TODO.md' ':!HUMAN-REQUEST.md' || true"
@cli! bash -lic "printf '%s\n' '--- Documentation files over 250 lines ---'; find docs -type f -name '*.md' -print0 | xargs -0 -r wc -l | awk '\$1 > 250 && \$2 != \"total\" {print}'"
@cli! bash -lic "if [[ -f tests/fixtures/consumer-release/boundary.lock.json && -f tests/fixtures/consumer-release/boundary-upgrade.lock.json ]]; then BOUNDARY_RELEASE_ARCHIVE_TESTS=1 PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer_release.py'; else printf '%s\n' 'release archive fixture not committed'; fi"
@cli! bash -lic 'printf '"'"'%s\n'"'"' '"'"'--- P10 release publication readiness ---'"'"'; git fetch -q --prune --no-tags origin || true; origin_url=$(git remote get-url origin 2>/dev/null || true); published_head=$(git ls-remote origin HEAD 2>/dev/null | awk '"'"'{print $1}'"'"'); printf '"'"'published_head=%s\nlocal_head=%s\n'"'"' "${published_head:-<unavailable>}" "$(git rev-parse HEAD 2>/dev/null || printf '"'"'<unavailable>'"'"')"; mapfile -t commits < <(git rev-list --remotes=origin --date-order --max-count=120 2>/dev/null); candidates=(); for commit in "${commits[@]}"; do ok=1; for path in scripts/consumer.py scripts/consumer_lock.py scripts/install.sh integration/speckit/extension.yml integration/speckit-preset/preset.yml integration/speckit/workflow-overlay.yml adapters/codex/materialize.py src/boundary/__init__.py skills/scope/SKILL.md skills/implement/SKILL.md skills/contracts/SKILL.md tests/test_consumer_release.py; do git cat-file -e "$commit:$path" 2>/dev/null || { ok=0; break; }; done; if (( ok )); then git grep -q '"'"'boundary.lock/v1'"'"' "$commit" -- scripts/consumer_lock.py 2>/dev/null || ok=0; fi; if (( ok )); then git grep -q '"'"'def materialize_locked_source'"'"' "$commit" -- scripts/consumer_lock.py 2>/dev/null || ok=0; fi; if (( ok )); then git grep -q '"'"'BOUNDARY_RELEASE_ARCHIVE_TESTS'"'"' "$commit" -- tests/test_consumer_release.py 2>/dev/null || ok=0; fi; if (( ok )); then git grep -q '"'"'boundary-upgrade.lock.json'"'"' "$commit" -- tests/test_consumer_release.py 2>/dev/null || ok=0; fi; if (( ok )); then candidates+=("$commit"); (( ${#candidates[@]} >= 2 )) && break; fi; done; if (( ${#candidates[@]} < 2 )); then printf '"'"'%s\n'"'"' '"'"'fewer than two usable published candidate commits contain the release-proof source'"'"'; else upgrade=${candidates[0]}; initial=${candidates[1]}; for label in initial upgrade; do commit=${!label}; if [[ "$origin_url" == https://github.com/* ]]; then base=${origin_url%.git}; url="$base/archive/$commit.tar.gz"; sha=$(python -c "import hashlib,sys,urllib.request; r=urllib.request.Request(sys.argv[1], headers={\"User-Agent\":\"Boundary release evidence\"}); print(hashlib.sha256(urllib.request.urlopen(r, timeout=60).read()).hexdigest())" "$url" 2>/dev/null || true); if [[ -n "$sha" ]]; then printf '"'"'%s revision=%s\n%s url=%s\n%s sha256=%s\n'"'"' "$label" "$commit" "$label" "$url" "$label" "$sha"; else printf '"'"'%s revision=%s\n%s url=%s\n%s sha256=<unavailable>\n'"'"' "$label" "$commit" "$label" "$url" "$label"; fi; done; else printf '"'"'%s\n'"'"' '"'"'origin is not an HTTPS GitHub repository; archive evidence cannot be derived'"'"'; fi; fi'
