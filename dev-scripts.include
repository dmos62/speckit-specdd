@# Surface bootstrap health, installed workflow state, full tests, fixture lint, patch integrity, canonical worktree state, and clean-clone acceptance.
@cli! bash -c "bash scripts/bootstrap.sh --check"
@cli! bash -c "specify workflow info speckit"
@cli! bash -c "specify workflow resolve speckit"
@cli! bash -c "specify workflow overlay list speckit"
@cli! bash -c "uv run --no-project python -m unittest discover -s tests -p 'test_*.py'"
@cli! bash -c "specdd lint tests/fixtures/specdd-two-domain"
@cli! bash -c "git diff --check"
@cli! bash -c "git status --short"
@cli! bash -c "printf '%s\n' '--- Tracked files matched by ignore rules ---'; git ls-files -ci --exclude-standard"
@cli! bash -c 'set -euo pipefail; tmp_dir="$(mktemp -d)"; trap "rm -rf -- \"$tmp_dir\"" EXIT; git clone --quiet --no-local . "$tmp_dir/repo"; cd "$tmp_dir/repo"; printf "%s\n" "--- Clean-clone source ---"; git rev-parse HEAD; bash scripts/bootstrap.sh; bash scripts/bootstrap.sh --check; uv run --no-project python -m unittest discover -s tests -p "test_*.py"; specdd lint tests/fixtures/specdd-two-domain; git diff --check; printf "%s\n" "--- Generated installation state after bootstrap ---"; git status --short --untracked-files=all -- .agents/skills .specify .specdd/bootstrap.local.md || true; canonical_status="$(git status --short --untracked-files=all -- . ":(glob,exclude).agents/skills/speckit-*/**" ":(glob,exclude).specify/extensions.yml" ":(glob,exclude).specify/extensions/specdd/**" ":(glob,exclude).specify/extensions/.cache/**" ":(glob,exclude).specify/extensions/.registry" ":(glob,exclude).specify/presets/specdd-bridge/**" ":(glob,exclude).specify/presets/.cache/**" ":(glob,exclude).specify/presets/.registry" ":(glob,exclude).specify-agent/commands/**" ":(glob,exclude).specify/scripts/**" ":(glob,exclude).specify/workflows/speckit/**" ":(glob,exclude).specify/workflows/overlays/**" ":(glob,exclude).specify/workflows/runs/**" ":(glob,exclude).specify/templates/**" ":(glob,exclude).specify/init-options.json" ":(glob,exclude).specify/integration.json" ":(glob,exclude).specify/integrations/*.manifest.json" ":(glob,exclude).specify/memory/constitution.md" ":(glob,exclude).specify/memory/.constitution-template.json" ":(glob,exclude).specify/workflows/workflow-registry.json" ":(glob,exclude).specdd/bootstrap.local.md")"; if [[ -n "$canonical_status" ]]; then printf "%s\n" "--- Unexpected canonical-source changes ---" >&2; printf "%s\n" "$canonical_status" >&2; exit 1; fi; ignored="$(git ls-files -ci --exclude-standard)"; if [[ -n "$ignored" ]]; then printf "%s\n" "$ignored" >&2; exit 1; fi; printf "%s\n" "clean-clone acceptance: PASS"'
