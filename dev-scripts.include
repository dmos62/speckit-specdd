@cli! bash -lic "log=\"${TMPDIR:-/tmp}/speckit-specdd-bootstrap-check.log\"; if bash scripts/bootstrap.sh --check >\"$log\" 2>&1; then tail -n 24 \"$log\"; else cat \"$log\"; exit 1; fi"
@cli! bash -lic "uv run --no-project python -m unittest discover -s tests -p 'test_preset.py'"
@cli! bash -lic "uv run --no-project python -m unittest discover -s tests -p 'test_workflow.py'"
