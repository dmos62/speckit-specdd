@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer*.py'"
@cli! bash -lic "if [[ -f tests/fixtures/consumer-release/boundary.lock.json && -f tests/fixtures/consumer-release/boundary-upgrade.lock.json ]]; then BOUNDARY_RELEASE_ARCHIVE_TESTS=1 PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer_release.py'; else printf '%s\n' 'release archive fixture not committed'; fi"
