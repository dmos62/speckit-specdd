@cli! bash -lic "log=\"${TMPDIR:-/tmp}/speckit-specdd-bootstrap-check.log\"; if bash scripts/bootstrap.sh --check >\"$log\" 2>&1; then tail -n 12 \"$log\"; else cat \"$log\"; exit 1; fi"
