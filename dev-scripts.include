@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m boundary contracts check"
@cli! bash -lic "PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer*.py'"
@cli! bash -lic "if [[ -f tests/fixtures/consumer-release/boundary.lock.json && -f tests/fixtures/consumer-release/boundary-upgrade.lock.json ]]; then BOUNDARY_RELEASE_ARCHIVE_TESTS=1 PYTHONPATH=src uv run --no-project python -m unittest discover -s tests -p 'test_consumer_release.py'; else printf '%s\n' 'release archive fixture not committed'; fi"
@cli! bash -lic 'printf '"'"'%s\n'"'"' '"'"'--- Git publication context ---'"'"'; git remote -v || true; git fetch -q --prune --no-tags origin || true; origin_url=$(git remote get-url origin 2>/dev/null || true); printf '"'"'%s\n'"'"' '"'"'--- Published refs ---'"'"'; git ls-remote origin HEAD '"'"'refs/heads/*'"'"' || true; printf '"'"'%s\n'"'"' '"'"'--- Remote branches containing local HEAD ---'"'"'; git branch -r --contains HEAD || true; printf '"'"'%s\n'"'"' '"'"'--- Recent published commits ---'"'"'; git log --remotes=origin -n 20 --format='"'"'%H %cI %s'"'"' || true; printf '"'"'%s\n'"'"' '"'"'--- Release-lock candidates ---'"'"'; mapfile -t commits < <(git rev-list --remotes=origin --date-order --max-count=120 2>/dev/null); candidates=(); for commit in "${commits[@]}"; do ok=1; for path in scripts/consumer.py scripts/consumer_lock.py scripts/install.sh integration/speckit/extension.yml integration/speckit-preset/preset.yml integration/speckit/workflow-overlay.yml adapters/codex/materialize.py src/boundary/__init__.py skills/scope/SKILL.md skills/implement/SKILL.md skills/contracts/SKILL.md tests/test_consumer_release.py; do git cat-file -e "$commit:$path" 2>/dev/null || { ok=0; break; }; done; if (( ok )); then git grep -q '"'"'boundary.lock/v1'"'"' "$commit" -- scripts/consumer_lock.py 2>/dev/null || ok=0; fi; if (( ok )); then candidates+=("$commit"); (( ${#candidates[@]} >= 2 )) && break; fi; done; if (( ${#candidates[@]} < 2 )); then printf '"'"'%s\n'"'"' '"'"'fewer than two published candidate commits contain the release-proof source'"'"'; else upgrade=${candidates[0]}; initial=${candidates[1]}; for label in initial upgrade; do commit=${!label}; if [[ "$origin_url" == https://github.com/* ]]; then base=${origin_url%.git}; url="$base/archive/$commit.tar.gz"; sha=$(python -c "import hashlib,sys,urllib.request; r=urllib.request.Request(sys.argv[1], headers={\"User-Agent\":\"Boundary release evidence\"}); print(hashlib.sha256(urllib.request.urlopen(r, timeout=60).read()).hexdigest())" "$url" 2>/dev/null || true); [[ -n "$sha" ]] || sha='"'"'<unavailable>'"'"'; printf '"'"'%s revision=%s\n%s url=%s\n%s sha256=%s\n'"'"' "$label" "$commit" "$label" "$url" "$label" "$sha"; else printf '"'"'%s\n'"'"' '"'"'origin is not an HTTPS GitHub repository; archive evidence cannot be derived'"'"'; break; fi; done; fi'
